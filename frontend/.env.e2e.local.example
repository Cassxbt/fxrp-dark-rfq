# Copy to .env.e2e.local (gitignored) and fill in three funded Coston2 burner
# keys, no 0x prefix required either way -- viem's privateKeyToAccount accepts
# both. Fund each with FXRP, USDT0, and a little C2FLR for gas via
# https://faucet.flare.network/. Never reuse a key you use elsewhere.
#
# Run with: npx tsx --env-file=.env.e2e.local scripts/e2e-demo.mts

TAKER_PRIVATE_KEY=
MAKER1_PRIVATE_KEY=
MAKER2_PRIVATE_KEY=
